# =============================================================================
#  Dockerfile.linux — build a standalone Linux executable of PhotoOrganizer.
#
#  Usage (via docker-compose):
#      docker compose run --rm build-linux
#  Output:
#      ./dist_docker/PhotoOrganizer-linux
#
#  The binary needs Tk on the machine that runs it. Most desktop Linux distros
#  already have it; on a minimal system:  sudo apt install libtk8.6
# =============================================================================
FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-tk tk-dev binutils && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir pyinstaller Pillow

COPY photo_organizer/ ./photo_organizer/
COPY run.py .

# Build inside the image so the layer is cached across container runs.
RUN pyinstaller \
        --onefile \
        --noconfirm \
        --name PhotoOrganizer \
        run.py

# Container run copies the built binary to the mounted /output volume.
CMD ["sh", "-c", "mkdir -p /output && cp dist/PhotoOrganizer /output/PhotoOrganizer-linux && echo 'Built: /output/PhotoOrganizer-linux'"]
